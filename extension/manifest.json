{
  "manifest_version": 3,
  "name": "Piole - Cosmetics Collection",
  "version": "1.0.0",
  "description": "Save cosmetics products to your Piole collection",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_title": "Save to Piole",
    "default_popup": "src/popup.html"
  },
  "side_panel": {
    "default_path": "src/sidebar.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"]
    }
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "host_permissions": [
    "*://*/*"
  ]
}
